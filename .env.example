# ---------------------------------------------------------------------------
# Copy to .env (local) and set the same keys in Vercel → Settings → Environment Variables.
# ---------------------------------------------------------------------------

# Public URL of the site (no trailing slash). Used for auth callbacks, emails, OG tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# PostgreSQL. On Neon use the *pooled* connection string.
DATABASE_URL=postgresql://mcat:mcat@localhost:5432/mcat

# Better Auth: generate with `openssl rand -base64 32`
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth (optional locally): https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Resend (optional locally; when unset, emails are printed to the server console)
RESEND_API_KEY=
EMAIL_FROM="MCAT Prep <hello@example.com>"

# Comma-separated emails that are promoted to ADMIN on sign-up / seed
ADMIN_EMAILS=

# Auth rate limiting is on in production and off in `next dev`. Set to 1 or 0 to override
# (e.g. AUTH_RATE_LIMIT=0 when running the Playwright suite against a production build).
AUTH_RATE_LIMIT=

# Vercel Blob read/write token: enables image uploads in forum posts (optional locally).
BLOB_READ_WRITE_TOKEN=

# Stripe (use TEST keys locally: https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=
# From `stripe listen` locally, or from `pnpm stripe:setup --webhook https://your.site` in production
STRIPE_WEBHOOK_SECRET=
