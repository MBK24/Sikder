# ---------------------------------------------------------------------------
# Copy to .env (local) and set the same keys in Vercel → Settings → Environment Variables.
# ---------------------------------------------------------------------------

# Public URL of the site (no trailing slash). Used for auth callbacks, emails, OG tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# PostgreSQL. On Neon use the *pooled* connection string.
DATABASE_URL=postgresql://mcat:mcat@localhost:5432/mcat

# Better Auth: generate with `openssl rand -base64 32`
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth (optional locally): https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Resend (optional locally; when unset, emails are printed to the server console)
RESEND_API_KEY=
EMAIL_FROM="MCAT Prep <hello@example.com>"

# Comma-separated emails that are promoted to ADMIN on sign-up / seed
ADMIN_EMAILS=
